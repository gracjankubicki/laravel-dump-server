{
    "name": "beyondcode/laravel-dump-server",
    "description": "Laravel dump server maintained for PHP 8.5, Laravel 13 and Symfony VarDumper 8.1",
    "keywords": [
        "beyondcode",
        "laravel-dump-server"
    ],
    "homepage": "https://github.com/gracjankubicki/laravel-dump-server",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcel Pociot",
            "email": "marcel@beyondco.de",
            "homepage": "https://beyondco.de",
            "role": "Developer"
        }
    ],
    "conflict": {
        "spatie/laravel-ray": "*"
    },
    "require": {
        "php": "^8.5",
        "illuminate/console": "^13.30",
        "illuminate/http": "^13.30",
        "illuminate/support": "^13.30",
        "symfony/var-dumper": "^8.1.10"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "BeyondCode\\DumpServer\\": "src"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BeyondCode\\DumpServer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@test",
            "@analyse",
            "@composer audit --no-interaction"
        ],
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "extra": {
        "laravel": {
            "providers": [
                "BeyondCode\\DumpServer\\DumpServerServiceProvider"
            ]
        }
    }
}
